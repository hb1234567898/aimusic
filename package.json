{
  "name": "orbit-music",
  "private": true,
  "version": "1.0.14",
  "description": "ORBIT liquid-glass music universe with QQ Music and Netease Cloud Music bridges",
  "author": "ORBIT Music",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8765",
    "dev:electron": "node scripts/dev-electron.mjs",
    "start": "electron .",
    "test": "node --test server/*.test.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8765",
    "build:electron:dir": "npm run build && electron-builder --dir",
    "build:electron": "npm run build && electron-builder",
    "release": "npm run build && node scripts/release.mjs && node scripts/fix-release.mjs",
    "fix-release": "node scripts/fix-release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.orbit.music.desktop",
    "productName": "ORBIT Music",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hb1234567898",
        "repo": "aimusic"
      }
    ],
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "server/**/*",
      "local-server.mjs",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ORBIT Music"
    }
  }
}
